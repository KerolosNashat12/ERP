# Copy to .env-style shell exports, or set these before `npm start`.
# Every value has a working default — nothing here is required.

MM_PORT=4000                 # HTTP port
MM_HOST=127.0.0.1            # use 0.0.0.0 to serve other PCs on the shop LAN
MM_OPEN_BROWSER=true         # open the browser automatically on start
MM_DATA_DIR=./data           # database + backups location (e.g. a USB drive)
MM_TOKEN_TTL=12h             # how long a sign-in lasts
MM_BCRYPT_ROUNDS=10          # password hashing cost
# MM_JWT_SECRET=             # generated and persisted on first run if unset
# MM_DB_FILE=                # full path to the SQLite file, overrides MM_DATA_DIR
